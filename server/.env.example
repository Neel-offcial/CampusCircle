# CampusCircle Server Environment Configuration

# Server Port
PORT=5050

# JWT Authentication Secret
JWT_SECRET=campuscircle-super-secret-jwt-key-2026

# Email Domain Validation
# Set to true to permit registration with personal emails (@gmail.com, @outlook.com) during testing
ALLOW_ANY_EMAIL=true

# Live SMTP Configuration (Optional)
# If provided, real emails will be delivered to student inboxes.
# If omitted or left blank, the server automatically uses Ethereal Virtual SMTP with instant web preview links.
#
# Examples:
# Gmail App Password (requires 2-Step Verification):
# SMTP_SERVICE=gmail
# SMTP_USER=your_college_club@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
#
# Brevo / Sendinblue:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_smtp_user
# SMTP_PASS=your_brevo_key
